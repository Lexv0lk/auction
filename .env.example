# Copy this file to .env for scripts/dev.ps1. Compose will load it in a later step.
# Do not commit .env or real secrets.
# PostgreSQL connection string; validated now, used for connections from step 03.
DATABASE_URL=postgres://auction:change-me@localhost:5432/auction?sslmode=disable
# The application's only HTTP listener, including health checks and future metrics.
HTTP_ADDR=127.0.0.1:8080
# Structured log threshold: debug, info, warn or error.
LOG_LEVEL=info
# Maximum PostgreSQL pool size and deadline for a single DB operation.
DB_MAX_CONNS=10
DB_TIMEOUT=5s
# Web request timeouts.
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
# Maximum bid transaction duration and graceful shutdown deadline.
BID_TX_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
# Background loop inside the server (implemented in step 11): polling interval and batch size.
WORKER_POLL_INTERVAL=1s
WORKER_BATCH_SIZE=100
# Future login session lifetime and whether cookies require HTTPS.
SESSION_TTL=24h
COOKIE_SECURE=false
# Future CSRF signing key; use an independently generated secret of at least 32 characters.
CSRF_SECRET=

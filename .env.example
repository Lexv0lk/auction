# Copy this file to .env for scripts/dev.ps1 and docker compose. Do not commit .env or real secrets.
# Password of the compose PostgreSQL containers (db on 5432, db-test on 5433).
# Must be URL-encoded when it contains special characters.
POSTGRES_PASSWORD=change-me
# Host ports of the compose databases; change them when a local PostgreSQL
# already occupies the default. The make test-integration targets build the
# test connection string from TEST_POSTGRES_PORT and POSTGRES_PASSWORD.
POSTGRES_PORT=5432
TEST_POSTGRES_PORT=5433
# PostgreSQL connection string used by the server and by make seed; must match
# POSTGRES_PASSWORD.
DATABASE_URL=postgres://auction:change-me@localhost:5432/auction?sslmode=disable
# Passwords of the demo accounts created by make seed (make migrate first).
# Logins are fixed: demo-admin (administrator) and demo-participant-1..3.
# The values below are local educational examples only; set your own values
# before pointing the seed at any database you do not fully control.
SEED_ADMIN_PASSWORD=change-me-admin
SEED_PARTICIPANT_PASSWORD=change-me-participant
# The application's only HTTP listener, including health checks and future metrics.
HTTP_ADDR=127.0.0.1:8080
# Structured log threshold: debug, info, warn or error.
LOG_LEVEL=info
# Maximum PostgreSQL pool size and deadline for a single DB operation.
DB_MAX_CONNS=10
DB_TIMEOUT=5s
# Web request timeouts.
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
# Maximum bid transaction duration and graceful shutdown deadline.
BID_TX_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s
# Background loop inside the server (implemented in step 11): polling interval and batch size.
WORKER_POLL_INTERVAL=1s
WORKER_BATCH_SIZE=100
# Future login session lifetime and whether cookies require HTTPS.
SESSION_TTL=24h
COOKIE_SECURE=false
# Future CSRF signing key; use an independently generated secret of at least 32 characters.
CSRF_SECRET=
